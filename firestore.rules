rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 120
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('role' in data) || (data.role is string && data.role.size() <= 150))
        && (!('department' in data) || (data.department is string && data.department.size() <= 150));
    }

    function isValidExperiment(data) {
      return data.id is string && data.id.size() <= 128
        && data.codeName is string && data.codeName.size() <= 100
        && data.title is string && data.title.size() <= 250
        && data.gravity is string && data.gravity.size() <= 100
        && data.material is string && data.material.size() <= 150
        && data.oxygenPercent is number && data.oxygenPercent >= 0 && data.oxygenPercent <= 100
        && (!('ownerId' in data) || data.ownerId == request.auth.uid);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc (for bootstrapping/verifying Firestore connectivity)
    match /test/{testDoc} {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;

      // User Research Data & Preferences
      match /data/{dataId} {
        allow read, write: if isOwner(userId);
      }

      // User Generated Veo Videos
      match /videos/{videoId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Microgravity Combustion Experiments Repository
    match /experiments/{experimentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidExperiment(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidExperiment(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
